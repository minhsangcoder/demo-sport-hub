# Only application source and the configuration/tooling needed to run it.
# Database schema/migrations/init scripts live under backend/ and stay included.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/docker-compose.yml
!/backend/
!/frontend/
!/contracts/
!/scripts/

# OpenAPI schemas are Backend source required by the API generation scripts.

# Technical documents, reports and AI instructions stay local, even inside source trees.
**/docs/
**/*.md
!/README.md
**/*.mdx
**/*.doc
**/*.docx
**/*.pdf
**/*.ppt
**/*.pptx
**/*.xls
**/*.xlsx

# Preserve attribution/licences for images and fonts required by the application.
!/frontend/public/images/credits.md
!/frontend/public/fonts/OFL.txt

# scripts/ contains Backend/database launch, build, seed and test code.
# Document-authoring helpers are not application source.
/scripts/build-project-report.py

# Runtime uploads, database backups and local data are not schema source.
**/uploads/
**/backups/
**/dumps/
*.dump
*.backup
*.bak
*.sql.gz
*.sql.zip
*.db
*.sqlite
*.sqlite3

# Environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# Java and Maven
**/target/
*.class
*.jar
*.war
*.ear

# Local generated/document helper files
generate_uc5_uc6_uc8_docx.py

# Split/internal design documents
Document/Dac_Ta_UC3_UC4_UC7.docx
Document/Dac_Ta_UC5_UC6_UC8.docx
Document/Dac_Ta_UC5_UC6_UC8.pdf
Document/SportHub_Microservices_Architecture.md

# Internal AI/audit notes
docs/phase-0-audit.md

# Node.js and Next.js
.pnpm-store/
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.vercel/
**/.parcel-cache/
**/.eslintcache
*.tsbuildinfo
coverage/

# Generated OpenAPI output
frontend/src/lib/api/generated/
backend/**/target/generated-sources/openapi/

# Temporary, cache, and generated document output
.docx-build/
.docx-review/
tmp/
temp/
.tmp/
.cache/
__pycache__/
*.py[cod]
*.log
logs/

# IDE and operating system files
.idea/
.vscode/
*.iml
.classpath
.project
.settings/
.DS_Store
Thumbs.db
Desktop.ini
